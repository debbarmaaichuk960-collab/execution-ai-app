[app]
title = On AI Super-App
package.name = onai
package.domain = org.onai
source.dir = .
source.exts = py,png,jpg,kv,atlas
version = 1.0
requirements = python3,kivy
orientation = portrait
fullscreen = 0
android.permissions = INTERNET,WRITE_EXTERNAL_STORAGE,READ_EXTERNAL_STORAGE
android.api = 33
android.minapi = 21
android.ndk = 28c
android.sdk = 33
[buildozer]
log_level = 2
warn_on_root = 1
